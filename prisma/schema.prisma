// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id    Int     @id @default(autoincrement())
  name  String?
  mobileNumber String  @unique
  email String?  @unique
  role  Role @default(user)
  city  String?
  refreshTokens Json? // Store refresh tokens as a JSON array
  orders Order[] 
  subscriptions Subscription[]
  trips Trip[]
  bookings Booking[] // For emergency, later need to delete it
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("users") // Map to the "users" table in the database
}

model Service {
  id    Int     @id @default(autoincrement())
  title  String @unique
  description String?
  thumbnailUrlKey String?
  isActive Boolean @default(true)
  packageServices PackageService[]
  createdAt DateTime @default(now())
  price Float @default(100)
  updatedAt DateTime @updatedAt
  @@map("services") // Map to the "services" table in the database
}
model Offers{
  id Int @id @default(autoincrement())
  packageId Int 
  end_date DateTime
}
enum PackageMediaType {
  IMAGE
  VIDEO
}

model Package {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  regularPrice    Float
  discountedPrice Float
  description     String?
  tags            String?
  vehicleType     String?
  vehicleModel    Json? // Store as JSON to allow for multiple models
  bodyguardType   String?
  trips           Int?
  category        String?
  validity        Int? // Validity in months
  thumbnailUrlKey String?
  isActive        Boolean  @default(true)

  packageServices PackageService[]
  packageMedia    PackageMedia[]
  coupons         Coupon[]
  offers          Offer[]
  orders          Order[]
  subscriptions   Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("packages")
}

model PackageMedia {
  id        Int              @id @default(autoincrement())
  packageId Int
  package   Package          @relation(fields: [packageId], references: [id], onDelete: Cascade)
  type      PackageMediaType
  urlKey    String
  order     Int              @default(0)
  createdAt DateTime         @default(now())

  @@index([packageId])
  @@map("package_media")
}

model PackageService {
  id    Int     @id @default(autoincrement())
  packageId Int
  serviceId Int
  count Int @default(1)

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([packageId, serviceId])
  @@map("package_services") // Map to the "package_services" table in the database
}

model Coupon {
  id    Int     @id @default(autoincrement())
  code  String  @unique
  discountType DiscountType
  discountValue Float
  usageLimit Int?
  usedCount Int @default(0)
  isActive Boolean @default(true)
  validUntil DateTime?
  packages Package[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("coupons") // Map to the "coupons" table in the database
}

model Order {
  id    Int     @id @default(autoincrement())
  userId Int
  packageId Int
  amount Float
  discountAmount Float
  finalAmount Float
  couponCode String?
  couponId Int?
  status String
  paymentId String?
  cashfreeOrderId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  package Package @relation(fields: [packageId], references: [id])
  @@map("orders") // Map to the "orders" table in the database
}

model Subscription {
  id    Int     @id @default(autoincrement())
  userId Int
  packageId Int
  startDate DateTime
  endDate DateTime
  status SubscriptionStatus @default(pending)
  paymentId String?
  tripsTotal Int?
  tripsUsed Int? @default(0)
  verifiedBy Int? // Store admin ID who verified
  verifiedAt DateTime?
  adminRemarks String?
  vehicleType String?
  bodyguardType String?
  category String?
  services Json? // Store subscribed services as JSON array
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  package Package @relation(fields: [packageId], references: [id])
  trips Trip[]
  @@map("subscriptions") // Map to the "subscriptions" table in the database
}

model Trip {
  id                 Int          @id @default(autoincrement())
  userId             Int
  subscriptionId     Int
  assignmentId       String?
  pickupLocation     String
  dropLocation       String
  tripDate           DateTime
  tripType           String
  status             tripStatus   @default(requested)
  confirmedBy        Int?
  cancelledBy        Int?
  cancellationReason String?
  createdBy          Int?
  services           Json?        // restructured — see below
  additionalAmount   Float        @default(0) // sum of addon charges only

  user               User         @relation(fields: [userId], references: [id])
  subscription       Subscription @relation(fields: [subscriptionId], references: [id])

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("trips")
}
// its for emergency , later need to delete it 
model Booking {
  id    Int     @id @default(autoincrement())
  userId Int
  packageId String // frontend id for now
  packageName String 
  cashfreeOrderId String? @unique
  status BookingStatus @default(initiated)
  purchaseDate DateTime @default(now())
  validity String? 
  purchaseAmount Float?
  currency String?
  serviceCity String?
  invoiceNumber String? @unique
  invoiceKey String? 
  user User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("bookings") // Map to the "bookings" table in the database
}

enum Role {
  user
  admin
  ops
}

enum tripStatus {
  requested
  confirmed
  completed
  cancelled
}

enum DiscountType {
  percentage
  fixed
}

enum SubscriptionStatus {
  pending
  active
  expired
  cancelled
}

enum BookingStatus {
  initiated
  pending
  active
  cancelled
  completed
  failed
}
model Offer {
  id        Int       @id @default(autoincrement())
  slug      String    @unique // "founding-fy-2026"

  isActive  Boolean   @default(true)
  startDate DateTime?            // 2026-07-01T00:00:00Z
  endDate   DateTime             // 2026-07-31T23:59:59Z

  category  String 

  alertText String    @default("Access Closes {date} — 11:59 PM IST")
  eyebrow   String?   // "Financial Year Founding Member Access"

  title       String  // "Lock In Founding Rates."
  titleAccent String? // "Before the FY Window Closes."

  description String? @db.Text // "After {date}, all new members pay the updated price..."

  countdownLabel String? // "Time remaining to claim founding rates"
  pricingLabel   String? // "Current founding rates — valid till {date}"

  benefitsHeading String?        // "What you get as a founding member"
  benefits        OfferBenefit[]

  deadlineNoteStrong String? // "After {date}:"
  deadlineNoteBody   String? @db.Text // "New memberships will be onboarded at the updated pricing..."

  ctaPrimaryText String? // "Claim Founding Rate — {packageName}"
  ctaPrimaryHref String? // "/booking/premium"

  featuredPackageId Int?
  featuredPackage   Package? @relation(fields: [featuredPackageId], references: [id], onDelete: SetNull)

  ctaSecondaryText String? // "Ask Concierge →"

  footerNote String? // "wensforce.com · +91-73046 07954 · Founding access closes {date}"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  

  @@map("offers")
}

model OfferBenefit {
  id      Int   @id @default(autoincrement())
  offerId Int
  offer   Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  icon        String      // "Tag" | "Star" | "CheckCircle"
  title       String      // "Current FY Pricing"
  description String @db.Text // "You pay today's rate for this membership year."
  order       Int    @default(0) // 0, 1, 2

  @@map("offer_benefits")
}