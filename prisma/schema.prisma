// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                  String           @id @db.VarChar(50)
  name                String?
  mobileNumber        String           @unique
  email               String?          @unique
  role                Role             @default(user)
  city                String?
  refreshTokens       Json?            // Store refresh tokens as a JSON array

  referredByUserId    String?          @db.VarChar(50)
  referredByUser      User?            @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referredUsers       User[]           @relation("UserReferrals")
  referralRewards     ReferralReward[]
  referralAuditLogs   TrackReferral[]  @relation("ReferrerTracks")
  orders              Order[]
  subscriptions       Subscription[]
  trips               Trip[]
  bookings            Booking[]        // For emergency, later need to delete it
  categoryReferralTracks UserReferralCategoryTrack[]
  refereeAuditLogs    TrackReferral[]  @relation("RefereeTracks")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@map("users")
}

model Service {
  id              String           @id @db.VarChar(50)
  title           String           @unique
  description     String?
  thumbnailUrlKey String?
  isActive        Boolean          @default(true)
  packageServices PackageService[]
  createdAt       DateTime         @default(now())
  price           Float            @default(100)
  updatedAt       DateTime         @updatedAt

  @@map("services")
}

model Offers {
  id        String   @id @db.VarChar(50)
  packageId String   @db.VarChar(50)
  end_date  DateTime
}

enum PackageMediaType {
  IMAGE
  VIDEO
}

model Package {
  id              String   @id @db.VarChar(50)
  name            String   @unique
  regularPrice    Float
  discountedPrice Float
  description     String?
  tags            String?
  vehicleType     String?
  vehicleModel    Json?
  bodyguardType   String?
  trips           Int?
  category        String?
  gst             Float?
  validity        Int?
  thumbnailUrlKey String?
  isActive        Boolean  @default(true)

  // ── TipTap rich text ──────────────────────────────────────────
  termsAndConditions Json?   // stores editor.getJSON() output
  // ─────────────────────────────────────────────────────────────

  packageServices PackageService[]
  packageMedia    PackageMedia[]
  coupons         Coupon[]
  offers          Offer[]
  orders          Order[]
  subscriptions   Subscription[]
  sequence        Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("packages")
}

model PackageMedia {
  id        String           @id @db.VarChar(50)
  packageId String           @db.VarChar(50)
  package   Package          @relation(fields: [packageId], references: [id], onDelete: Cascade)
  type      PackageMediaType
  urlKey    String
  order     Int              @default(0)
  createdAt DateTime         @default(now())

  @@index([packageId])
  @@map("package_media")
}

model PackageService {
  id        String @id @db.VarChar(50)
  packageId String @db.VarChar(50)
  serviceId String @db.VarChar(50)
  count     Int    @default(1)

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([packageId, serviceId])
  @@map("package_services")
}

model Coupon {
  id            String       @id @db.VarChar(50)
  code          String       @unique
  discountType  DiscountType
  discountValue Float
  usageLimit    Int?
  usedCount     Int          @default(0)
  isActive      Boolean      @default(true)
  validUntil    DateTime?
  packages      Package[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("coupons")
}

model Order {
  id                      String    @id @db.VarChar(50)
  userId                  String    @db.VarChar(50)
  packageId               String    @db.VarChar(50)
  packageName             String
  amount                  Float
  discountAmount          Float
  finalAmount             Float
  couponCode              String?
  couponId                String?   @db.VarChar(50)
  paidAt                  DateTime?
  status                  String
  currency                String    @default("INR")
  paymentId               String?
  cashfreeOrderId         String?   @unique
  invoiceNumber           String?       @unique
  invoiceKey              String?
  appliedReferralCode     String?
  appliedReferralRewardId String?   @db.VarChar(50)
  referralDiscountAmount  Float?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user    User    @relation(fields: [userId],    references: [id])
  package Package @relation(fields: [packageId], references: [id])

  @@map("orders")
}

model Subscription {
  id            String             @id @db.VarChar(50)
  userId        String             @db.VarChar(50)
  packageId     String             @db.VarChar(50)
  startDate     DateTime
  endDate       DateTime
  status        SubscriptionStatus @default(pending)
  paymentId     String?
  tripsTotal    Int?
  tripsUsed     Int?               @default(0)
  verifiedBy    String?            @db.VarChar(50) // Store admin ID who verified
  verifiedAt    DateTime?
  adminRemarks  String?
  vehicleType   String?
  bodyguardType String?
  category      String?
  services      Json?              // Store subscribed services as JSON array
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user    User    @relation(fields: [userId],    references: [id])
  package Package @relation(fields: [packageId], references: [id])
  trips   Trip[]

  @@map("subscriptions")
}

model Trip {
  id                 String     @id @db.VarChar(50)
  userId             String     @db.VarChar(50)
  subscriptionId     String     @db.VarChar(50)
  assignmentId       String?
  pickupLocation     String
  dropLocation       String
  tripDate           DateTime
  tripType           String
  status             tripStatus @default(requested)
  confirmedBy        String?    @db.VarChar(50)
  cancelledBy        String?    @db.VarChar(50)
  cancellationReason String?
  createdBy          String?    @db.VarChar(50)
  services           Json?      // restructured — see below
  additionalAmount   Float      @default(0) // sum of addon charges only

  user         User         @relation(fields: [userId],         references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("trips")
}

// its for emergency , later need to delete it
model Booking {
  id              String        @id @db.VarChar(50)
  userId          String        @db.VarChar(50)
  packageId       String        @db.VarChar(50) // frontend id for now
  packageName     String
  cashfreeOrderId String?       @unique
  status          BookingStatus @default(initiated)
  purchaseDate    DateTime      @default(now())
  validity        String?
  purchaseAmount  Float?
  currency        String?
  serviceCity     String?
  invoiceNumber   String?       @unique
  invoiceKey      String?
  user            User          @relation(fields: [userId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("bookings")
}

enum Role {
  user
  admin
  ops
}

enum tripStatus {
  requested
  confirmed
  completed
  cancelled
}

enum DiscountType {
  percentage
  fixed
}

enum SubscriptionStatus {
  pending
  active
  expired
  cancelled
}

enum BookingStatus {
  initiated
  pending
  active
  cancelled
  completed
  failed
}

model Offer {
  id        String    @id @db.VarChar(50)
  slug      String    @unique

  isActive  Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime

  category  String

  alertText String    @default("Access Closes {date} — 11:59 PM IST")
  eyebrow   String?

  title       String
  titleAccent String?
  description String? @db.Text

  countdownLabel String?
  pricingLabel   String?

  benefitsHeading String?
  benefits        OfferBenefit[]

  deadlineNoteStrong String?
  deadlineNoteBody   String? @db.Text

  ctaPrimaryText String?
  ctaPrimaryHref String?

  // ── changed: array of packages ──
  featuredPackages Package[]

  ctaSecondaryText String?
  footerNote       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("offers")
}

model OfferBenefit {
  id      String @id @db.VarChar(50)
  offerId String @db.VarChar(50)
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  icon        String      // "Tag" | "Star" | "CheckCircle"
  title       String      // "Current FY Pricing"
  description String @db.Text // "You pay today's rate for this membership year."
  order       Int    @default(0) // 0, 1, 2

  @@map("offer_benefits")
}

// ── Referral System ──────────────────────────────────────────────────────────

enum ReferralProgramStatus {
  active
  paused
  cancelled
}

enum RewardType {
  none
  discount
  wallet
}

enum PackageRewardType {
  any
  custom
}

model ReferralProgram {
  id                      String                @id @db.VarChar(50)
  name                    String
  packageCategory         String
  startDate               DateTime?
  endDate                 DateTime?
  programStatus           ReferralProgramStatus @default(active)
  maxTotalRedemptions     Int?
  totalRedemptionCount    Int                   @default(0)
  maxRedemptionsPerUser   Int?
  rewardOnSignup          Boolean               @default(false)
  referrerTriggerPackages ReferralTriggerPackage[]
  referrerRewardType      RewardType?
  referrerRewardCalcType  DiscountType?
  referrerRewardValue     Float?
  referrerPackageScope    PackageRewardType?
  referrerAllowedPackages ReferralProgramReferrerPackage[]
  refereeRewardType       RewardType?
  refereeRewardCalcType   DiscountType?
  refereeRewardValue      Float?
  refereePackageScope     PackageRewardType?
  refereeAllowedPackages  ReferralProgramRefereePackage[]
  referralEvents          TrackReferral[]
  categoryReferralTracks  UserReferralCategoryTrack[]
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
}

model ReferralTriggerPackage {
  id                  String          @id @db.VarChar(50)
  referralProgramId   String          @db.VarChar(50)
  packageId           String          @db.VarChar(50)
  referralProgram     ReferralProgram @relation(fields: [referralProgramId], references: [id], onDelete: Cascade)
  packageNameSnapshot String?

  @@unique([referralProgramId, packageId])
}

model ReferralProgramReferrerPackage {
  id                  String          @id @db.VarChar(50)
  referralProgramId   String          @db.VarChar(50)
  packageId           String          @db.VarChar(50)
  packageNameSnapshot String?
  referralProgram     ReferralProgram @relation(fields: [referralProgramId], references: [id], onDelete: Cascade)
}

model ReferralProgramRefereePackage {
  id                  String          @id @db.VarChar(50)
  referralProgramId   String          @db.VarChar(50)
  packageId           String          @db.VarChar(50)
  packageNameSnapshot String?
  referralProgram     ReferralProgram @relation(fields: [referralProgramId], references: [id], onDelete: Cascade)
}

model UserReferralCategoryTrack {
  id                String    @id @db.VarChar(50)
  userId            String    @db.VarChar(50)
  referralProgramId String    @db.VarChar(50)
  category          String    // snapshot of ReferralProgram.packageCategory
  referralCode      String    @unique
  redemptions       Int       @default(0)
  maxRedemptions    Int?      // snapshot of ReferralProgram.maxRedemptionsPerUser
  lastRedeemedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralProgram ReferralProgram @relation(fields: [referralProgramId], references: [id], onDelete: Cascade)

  @@unique([userId, referralProgramId])
  @@index([category])
  @@map("user_referral_category_track")
}

model TrackReferral {
  id                          String      @id @db.VarChar(50)
  referralProgramId           String      @db.VarChar(50)
  referralProgramNameSnapshot String
  referrerUserId              String      @db.VarChar(50)
  refereeUserId               String      @db.VarChar(50)
  triggeredBySignup           Boolean
  referrerRewardTypeSnapshot  RewardType?
  referrerRewardSnapshot      Json?
  refereeRewardTypeSnapshot   RewardType?
  refereeRewardSnapshot       Json?
  referrerReferralRewardId    String?     @db.VarChar(50)
  triggeringOrderId           String?     @db.VarChar(50)
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  referralProgram ReferralProgram @relation(fields: [referralProgramId], references: [id])
  referrer        User            @relation("ReferrerTracks", fields: [referrerUserId], references: [id])
  referee         User            @relation("RefereeTracks", fields: [refereeUserId], references: [id])

  @@index([referrerUserId])
  @@index([refereeUserId])
}

model ReferralReward {
  id                 String       @id @db.VarChar(50)
  userId             String       @db.VarChar(50)
  rewardCalcType     DiscountType
  rewardValue        Float
  rewardAmountINR    Float
  eligiblePackageIds Json         @default("[]")
  isRedeemed         Boolean      @default(false)
  redemptionDetails  Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
